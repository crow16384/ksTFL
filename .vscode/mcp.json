{
  "servers": {
    "oraios/serena": {
      "type": "stdio",
      "command": "${workspaceFolder}/tools/start_serena.sh",
      "args": [
        "${workspaceFolder}"
      ]
    },
    "cclsp/clangd": {
      "type": "stdio",
      "command": "${workspaceFolder}/tools/start_cclsp.sh",
      "env": {
        "CCLSP_CONFIG_PATH": "${workspaceFolder}/cclsp.json"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  },
  "inputs": []
}