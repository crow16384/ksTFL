  c_format,
  
  # Style context manipulation (generic)
  add_style,
  
  # Column definition
  define_cols,
  
  # Content functions (title, subtitle, footnote)
  add_title,
  add_subtitle,
  add_footnote,
  
  # Body text functions (generic)
  add_body_text,
  
  # Header functions (generic)
  add_header,
  
  # Footer functions (generic)
  add_footer,
  
  # Stub column definition
  add_stub_column,
  
  # Document configuration
  set_document,
  set_page_style,
  
  # Specification preview
  preview_spec,
  
  # Package options functions
  tfl_get_options,
  tfl_get_option,
  tfl_set_options,
  tfl_reset_options
)

# S3 method registrations for add_style
S3method(add_style, TFL_spec)
