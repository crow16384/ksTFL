{
  "document": {
    "page": {
      "size": "A4",
      "orientation": "landscape",
      "margins": {
        "top": "1.0in",
        "bottom": "1.0in",
        "left": "0.5in",
        "right": "0.5in",
        "header": "1cm",
        "footer": "1cm"
      }
    },
    "paragraphDefaults": {
      "widow_control": true
    }
  },

  "textStyles": {
    "default": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        },
        "indents": {
          "left": "0pt",
          "right": "0pt",
          "first_line": "0pt"
        }
      }
    },
    "docHeader": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 0.9
        }
      }
    },
    "docFooter": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 0.9
        }
      }
    },
    "titles": {
      "font": {
        "font_name": "Courier New",
        "font_size": "10pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "1pt",
          "line_spacing": 1.2
        }
      }
    },
    "subtitles": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "2pt",
          "line_spacing": 1.0
        }
      }
    },
    "footnotes": {
      "font": {
        "font_name": "Arial",
        "font_size": "8pt",
        "bold": false,
        "italic": true,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "5pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "tableHeader": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "tableBody": {
      "font": {
        "font_name": "Courier New",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    }
  },

  "tableStyle": {
    "layout": {
      "allow_row_break_across_pages": false,
      "repeat_header_on_each_page": true,
      "prevent_header_row_break": true,
      "table_alignment": "center"
    },

    "structural": {
      "header_top_border": {
        "color": "000000",
        "width": "1.5pt",
        "line_style": "single"
      },
      "header_bottom_border": {
        "color": "000000",
        "width": "1.5pt",
        "line_style": "single"
      },
      "table_bottom_border": {
        "color": "000000",
        "width": "1.5pt",
        "line_style": "single"
      },
      "allHeaders": {
        "vertical_alignment": "center"
      },
      "tableBody": {
        "vertical_alignment": "center"
      }
    },

    "cellDefaults": {
      "cell_margins": {
        "top": "1pt",
        "bottom": "1pt",
        "left": "2pt",
        "right": "1pt"
      },
      "vertical_alignment": "center"
    },

    "header": {
      "row": {
        "background_color": null,
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "1pt",
          "bottom": "1pt",
          "left": "2pt",
          "right": "2pt"
        },
        "borders": {
          "top": {
            "color": "000000",
            "width": "1.2pt",
            "line_style": "single"
          },
          "bottom": {
            "color": "000000",
            "width": "1.2pt",
            "line_style": "single"
          },
          "left": {
            "color": null,
            "width": "0pt",
            "line_style": "none"
          },
          "right": {
            "color": null,
            "width": "0pt",
            "line_style": "none"
          }
        }
      }
    },

    "body": {
      "row": {
        "background_color": null,
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "1pt",
          "bottom": "1pt",
          "left": "2pt",
          "right": "1pt"
        },
        "borders": {
          "top": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "bottom": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "left": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "right": {
            "color": null,
            "width": null,
            "line_style": "none"
          }
        }
      }
    }
  }
}
