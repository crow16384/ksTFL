{
  "document": {
    "page": {
      "size": "A4",
      "orientation": "landscape",
      "margins": {
        "top": "0.75in",
        "bottom": "0.75in",
        "left": "0.5in",
        "right": "0.5in",
        "header": "0.35in",
        "footer": "0.35in"
      }
    },
    "paragraphDefaults": {
      "widow_control": true
    }
  },
  "textStyles": {
    "default": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        },
        "indents": {
          "left": "0pt",
          "right": "0pt",
          "first_line": "0pt"
        }
      }
    },
    "docHeader": {
      "font": {
        "font_name": "Arial",
        "font_size": "8pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "docFooter": {
      "font": {
        "font_name": "Arial",
        "font_size": "8pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "titles": {
      "font": {
        "font_name": "Arial",
        "font_size": "11pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "2E4A6A"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1.2
        }
      }
    },
    "subtitles": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "2pt",
          "line_spacing": 1.0
        }
      }
    },
    "footnotes": {
      "font": {
        "font_name": "Arial",
        "font_size": "8pt",
        "bold": false,
        "italic": true,
        "underline": false,
        "color": "444444"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "4pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "tableHeader": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "1A2840"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.0
        }
      }
    },
    "tableBody": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1.15
        }
      }
    },
    "tocTitle": {
      "font": {
        "font_name": "Arial",
        "font_size": "11pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "2E4A6A"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1.2
        }
      }
    },
    "tocEntry": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "2pt",
          "line_spacing": 1.0
        }
      }
    },
    "figureCaption": {
      "font": {
        "font_name": "Arial",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "1A1A1A"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "2pt",
          "line_spacing": 1.0
        }
      }
    }
  },
  "tableStyle": {
    "layout": {
      "allow_row_break_across_pages": false,
      "repeat_header_on_each_page": true,
      "prevent_header_row_break": true,
      "table_alignment": "center",
      "topEmptyLine": "0pt",
      "bottomEmptyLine": "0pt"
    },
    "structural": {
      "header_top_border": {
        "color": "2E4A6A",
        "width": "1.5pt",
        "line_style": "single"
      },
      "header_bottom_border": {
        "color": "2E4A6A",
        "width": "1.0pt",
        "line_style": "single"
      },
      "table_bottom_border": {
        "color": "2E4A6A",
        "width": "1.5pt",
        "line_style": "single"
      },
      "allHeaders": {
        "vertical_alignment": "center"
      },
      "tableBody": {
        "vertical_alignment": "center"
      }
    },
    "cellDefaults": {
      "cell_margins": {
        "top": "2pt",
        "bottom": "2pt",
        "left": "4pt",
        "right": "4pt"
      },
      "vertical_alignment": "center"
    },
    "header": {
      "row": {
        "background_color": "D4DCE8",
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "3pt",
          "bottom": "3pt",
          "left": "4pt",
          "right": "4pt"
        },
        "borders": {
          "top": {
            "color": "2E4A6A",
            "width": "1.5pt",
            "line_style": "single"
          },
          "bottom": {
            "color": "2E4A6A",
            "width": "1.0pt",
            "line_style": "single"
          },
          "left": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "right": {
            "color": null,
            "width": null,
            "line_style": "none"
          }
        }
      }
    },
    "body": {
      "row": {
        "background_color": null,
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "2pt",
          "bottom": "2pt",
          "left": "4pt",
          "right": "4pt"
        },
        "borders": {
          "top": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "bottom": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "left": {
            "color": null,
            "width": null,
            "line_style": "none"
          },
          "right": {
            "color": null,
            "width": null,
            "line_style": "none"
          }
        }
      }
    }
  },
  "figureStyle": {
    "layout": {
      "alignment": "center",
      "space_before": "3pt",
      "space_after": "3pt"
    },
    "caption": {
      "position": "below",
      "textStyleRef": "figureCaption"
    }
  }
}
