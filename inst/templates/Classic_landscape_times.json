{
  "document": {
    "page": {
      "size": "A4",
      "orientation": "landscape",
      "margins": {
        "top": "0.5in",
        "bottom": "0.5in",
        "left": "0.5in",
        "right": "0.5in",
        "header": "0.5in",
        "footer": "0.5in"
      }
    },
    "paragraphDefaults": {
      "widow_control": true
    }
  },
  "textStyles": {
    "default": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1
        },
        "indents": {
          "left": "0pt",
          "right": "0pt",
          "first_line": "0pt"
        }
      }
    },
    "docHeader": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "8pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1
        }
      }
    },
    "docFooter": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "8pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1
        }
      }
    },
    "titles": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "10pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "6pt",
          "line_spacing": 1
        }
      }
    },
    "subtitles": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1
        }
      }
    },
    "footnotes": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "8pt",
        "bold": false,
        "italic": true,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1
        }
      }
    },
    "tableHeader": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "9pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "center",
        "spacing": {
          "before": "0pt",
          "after": "0pt",
          "line_spacing": 1
        }
      }
    },
    "tableBody": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "1pt",
          "after": "1pt",
          "line_spacing": 1
        }
      }
    },
    "tocTitle": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "12pt",
        "bold": true,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "10pt",
          "line_spacing": 1.1
        }
      }
    },
    "tocEntry": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "9pt",
        "bold": false,
        "italic": false,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "1pt",
          "line_spacing": 1
        }
      }
    },
    "figureCaption": {
      "font": {
        "font_name": "Times New Roman",
        "font_size": "10pt",
        "bold": false,
        "italic": true,
        "underline": false,
        "color": "000000"
      },
      "paragraph": {
        "alignment": "left",
        "spacing": {
          "before": "0pt",
          "after": "4pt",
          "line_spacing": 1
        }
      }
    }
  },
  "tableStyle": {
    "layout": {
      "allow_row_break_across_pages": false,
      "repeat_header_on_each_page": true,
      "prevent_header_row_break": true,
      "table_alignment": "center",
      "topEmptyLine": "6pt",
      "bottomEmptyLine": "6pt"
    },
    "structural": {
      "header_top_border": {
        "color": "000000",
        "width": "1.1pt",
        "line_style": "single"
      },
      "header_bottom_border": {
        "color": "000000",
        "width": "1.1pt",
        "line_style": "single"
      },
      "table_bottom_border": {
        "color": "000000",
        "width": "1.1pt",
        "line_style": "single"
      },
      "allHeaders": {
        "vertical_alignment": "center"
      },
      "tableBody": {
        "vertical_alignment": "center"
      }
    },
    "cellDefaults": {
      "cell_margins": {
        "top": "2pt",
        "bottom": "2pt",
        "left": "2pt",
        "right": "4pt"
      },
      "vertical_alignment": "center"
    },
    "header": {
      "row": {
        "background_color": null,
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "3pt",
          "bottom": "3pt",
          "left": "2pt",
          "right": "2pt"
        },
        "borders": {
          "top": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "bottom": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "left": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "right": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          }
        },
        "text_orientation": "horizontal"
      }
    },
    "body": {
      "row": {
        "background_color": null,
        "row_height": "auto",
        "vertical_alignment": "center",
        "cell_margins": {
          "top": "2pt",
          "bottom": "2pt",
          "left": "2pt",
          "right": "4pt"
        },
        "borders": {
          "top": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "bottom": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "left": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          },
          "right": {
            "color": "AAAAAA",
            "width": "0.8pt",
            "line_style": "single"
          }
        },
        "text_orientation": "horizontal"
      }
    }
  },
  "figureStyle": {
    "layout": {
      "alignment": "center",
      "space_before": "0pt",
      "space_after": "4pt"
    },
    "caption": {
      "position": "below",
      "textStyleRef": "figureCaption"
    }
  }
}
