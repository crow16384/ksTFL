{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "style": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols", "styleRef"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "styleRef": { "type": "string" },
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "merge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          },
          "styleRef": { "type": "string" },
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "add_row": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pos", "value_from"],
        "properties": {
          "pos": {
            "type": "string",
            "enum": ["above", "below"]
          },
          "value_from": {
            "type": "string"
          },
          "styleRef": {
            "type": "string"
          },
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
    ,
    "clear": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
    ,
    "glue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols", "position"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "position": {
            "type": "string",
            "enum": ["before", "after"]
          },
          "glue_col":  { "type": "string" },
          "text":      { "type": "string" },
          "separator": { "type": "string" },
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
    ,
    "page_break": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
