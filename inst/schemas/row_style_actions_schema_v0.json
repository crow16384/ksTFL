{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "style": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols", "styleRef"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "styleRef": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "merge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cols"],
        "properties": {
          "cols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          },
          "styleRef": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "add_row": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pos", "value_from"],
        "properties": {
          "pos": {
            "type": "string",
            "enum": ["above", "below"]
          },
          "value_from": {
            "type": "string"
          },
          "styleRef": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
