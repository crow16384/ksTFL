{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Clinical TFL Styling Template Schema",
    "description": "Schema for defining document styling properties for clinical Tables, Figures, and Listings (TFL) using python-docx library",
    "properties": {
        "document": {
            "type": "object",
            "title": "Document Properties",
            "description": "Global document settings including page layout and margins",
            "properties": {
                "page": {
                    "type": "object",
                    "title": "Page Settings",
                    "description": "Document page configuration including size, orientation, and margins",
                    "properties": {
                        "size": {
                            "type": "string",
                            "title": "Page Size",
                            "description": "Standard paper size for the document",
                            "default": "A4",
                            "enum": [
                                "A4",
                                "A3",
                                "Letter",
                                "Legal",
                                "Executive"
                            ]
                        },
                        "orientation": {
                            "type": "string",
                            "title": "Page Orientation",
                            "description": "Page layout direction",
                            "default": "landscape",
                            "enum": [
                                "portrait",
                                "landscape"
                            ]
                        },
                        "margins": {
                            "type": "object",
                            "title": "Page Margins",
                            "description": "Margin measurements for all sides of the page",
                            "properties": {
                                "top": {
                                    "type": "string",
                                    "title": "Top Margin",
                                    "description": "Distance from top edge of page to main content area",
                                    "default": "1.5cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                },
                                "bottom": {
                                    "type": "string",
                                    "title": "Bottom Margin",
                                    "description": "Distance from bottom edge of page to main content area",
                                    "default": "1.5cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                },
                                "left": {
                                    "type": "string",
                                    "title": "Left Margin",
                                    "description": "Distance from left edge of page to main content area",
                                    "default": "1.5cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                },
                                "right": {
                                    "type": "string",
                                    "title": "Right Margin",
                                    "description": "Distance from right edge of page to main content area",
                                    "default": "1.5cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                },
                                "header": {
                                    "type": "string",
                                    "title": "Header Margin",
                                    "description": "Distance from top edge of page to header content",
                                    "default": "1cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                },
                                "footer": {
                                    "type": "string",
                                    "title": "Footer Margin",
                                    "description": "Distance from bottom edge of page to footer content",
                                    "default": "1cm",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?(mm|cm|in|pt)$"
                                }
                            },
                            "required": [
                                "top",
                                "bottom",
                                "left",
                                "right",
                                "header",
                                "footer"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "size",
                        "orientation",
                        "margins"
                    ]
                }
            },
            "required": [
                "page"
            ]
        },
        "textStyles": {
            "type": "object",
            "title": "Text Styles Configuration",
            "description": "Definition of all text styles used throughout the document",
            "properties": {
                "default": {
                    "$ref": "#/$defs/textStyles"
                },
                "docHeader": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Document header style"
                },
                "docFooter": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Document footer text style"
                },
                "titles": {
                    "$ref": "#/$defs/textStyles",
                    "title": "style of table titles"
                },
                "subtitles": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Style of table subtitles"
                },
                "footnotes": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Style of table footnotes"
                },
                "tableHeader": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Styles of table headers"
                },
                "tableBody": {
                    "$ref": "#/$defs/textStyles",
                    "title": "Style of table body"
                }
            },
            "required": [
                "default",
                "titles",
                "subtitles",
                "footnotes"
            ]
        },
        "tableStyle": {
            "type": "object",
            "title": "Table Styling Configuration",
            "description": "Comprehensive table formatting and styling properties",
            "properties": {
                "layout": {
                    "type": "object",
                    "title": "Table Layout Settings",
                    "description": "Overall table structure and behavior settings",
                    "properties": {
                        "autofit": {
                            "type": "boolean",
                            "title": "AutoFit Behavior",
                            "description": "Whether table should automatically adjust column widths to content"
                        },
                        "preferred_width": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Preferred Table Width",
                            "description": "Desired width of the table as percentage or absolute measurement",
                            "pattern": "^[0-9]+(\\.[0-9]+)?(%|mm|cm|in|pt)$"
                        },
                        "row_height": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Default Row Height",
                            "description": "Standard height for table rows",
                            "default": "auto",
                            "pattern": "^([0-9]+(\\.[0-9]+)?mm)|(auto)$"
                        },
                        "allow_row_break_across_pages": {
                            "type": "boolean",
                            "title": "Allow Row Breaking",
                            "description": "Whether table rows can split across page boundaries"
                        },
                        "repeat_header_on_each_page": {
                            "type": "boolean",
                            "title": "Repeat Header Row",
                            "description": "Whether header row should repeat on each page for multi-page tables"
                        },
                        "background_color": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Table Background Color (shading)",
                            "description": "Default background color for the entire table",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                        }
                    },
                    "required": [
                        "autofit",
                        "preferred_width",
                        "row_height",
                        "allow_row_break_across_pages",
                        "repeat_header_on_each_page"
                    ]
                },
                "outer_borders": {
                    "type": "object",
                    "title": "Outer Table Borders",
                    "description": "Border styling for the outer edges of the table. Top border is not included as it is defined by the table header definition",
                    "properties": {
                        "left": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Left Border",
                            "description": "Border properties for the left edge of the table"
                        },
                        "right": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Right Border",
                            "description": "Border properties for the right edge of the table"
                        },
                        "bottom": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Bottom Border",
                            "description": "Border properties for the bottom edge of the table"
                        }
                    },
                    "required": [
                        "left",
                        "right",
                        "bottom"
                    ]
                },
                "inner_borders": {
                    "type": "object",
                    "title": "Inner Table Borders",
                    "description": "Border styling for the inner grid lines of the table",
                    "properties": {
                        "left": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Left Inner Border",
                            "description": "Border properties for inner left edges"
                        },
                        "right": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Right Inner Border",
                            "description": "Border properties for inner right edges"
                        },
                        "bottom": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Bottom Inner Border",
                            "description": "Border properties for inner bottom edges"
                        }
                    },
                    "required": [
                        "left",
                        "right",
                        "bottom"
                    ]
                },
                "header": {
                    "type": "object",
                    "title": "Table Header Styling",
                    "description": "Special formatting for different types of header rows",
                    "properties": {
                        "top_row": {
                            "$ref": "#/$defs/tableRowStyle",
                            "title": "Top Header Row",
                            "description": "Styling for the first header row of the table"
                        },
                        "bottom_row": {
                            "$ref": "#/$defs/tableRowStyle",
                            "title": "Bottom Header Row",
                            "description": "Styling for the last header row of multi-level headers"
                        },
                        "inbetween_rows": {
                            "$ref": "#/$defs/tableRowStyle",
                            "title": "In-between Header Rows",
                            "description": "Styling for header rows between top and bottom headers"
                        }
                    },
                    "required": [
                        "top_row",
                        "bottom_row",
                        "inbetween_rows"
                    ]
                },
                "body": {
                    "type": "object",
                    "title": "Table Body Styling",
                    "description": "Formatting for the main data rows of the table",
                    "properties": {
                        "background_color": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Body Background Color",
                            "description": "Default background color for table body rows",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        "row_height": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Body Row Height",
                            "description": "Height for table body rows",
                            "pattern": "^([0-9]+(\\.[0-9]+)?mm)|(auto)$"
                        },
                        "vertical_alignment": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Vertical Cell Alignment",
                            "description": "Vertical alignment of content within table cells",
                            "enum": [
                                "top",
                                "center",
                                "bottom"
                            ]
                        },
                        "alternate_rows_shading": {
                            "type": "object",
                            "title": "Alternate Row Shading",
                            "description": "Zebra-striping configuration for table rows",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "title": "Alternate Shading Enabled",
                                    "description": "Whether alternate row background coloring is active"
                                },
                                "background_color": {
                                    "type": "string",
                                    "title": "Alternate Row Color",
                                    "description": "Background color for alternate rows when shading is enabled",
                                    "pattern": "^#[0-9A-Fa-f]{6}$"
                                }
                            },
                            "required": [
                                "enabled",
                                "background_color"
                            ]
                        },
                        "borders": {
                            "type": "object",
                            "title": "Body Cell Borders",
                            "description": "Border styling for table body cells",
                            "properties": {
                                "top": {
                                    "$ref": "#/$defs/borderProperties",
                                    "title": "Top Border",
                                    "description": "Border properties for top edges of body cells"
                                },
                                "bottom": {
                                    "$ref": "#/$defs/borderProperties",
                                    "title": "Bottom Border",
                                    "description": "Border properties for bottom edges of body cells"
                                },
                                "left": {
                                    "$ref": "#/$defs/borderProperties",
                                    "title": "Left Border",
                                    "description": "Border properties for left edges of body cells"
                                },
                                "right": {
                                    "$ref": "#/$defs/borderProperties",
                                    "title": "Right Border",
                                    "description": "Border properties for right edges of body cells"
                                }
                            },
                            "required": [
                                "top",
                                "bottom",
                                "left",
                                "right"
                            ]
                        }
                    },
                    "required": [
                        "background_color",
                        "row_height",
                        "vertical_alignment",
                        "borders"
                    ]
                }
            },
            "required": []
        },
        "_styleName": {
            "type": [
                "null",
                "string"
            ]
        },
        "_generated": {
            "type": [
                "null",
                "string"
            ]
        },
        "_schemaVersion": {
            "type": [
                "null",
                "string"
            ]
        },
        "_generator": {
            "type": [
                "null",
                "string"
            ]
        },
        "_comment": {
            "type": [
                "null",
                "string"
            ]
        }
    },
    "required": [
        "document",
        "textStyles",
        "tableStyle"
    ],
    "$defs": {
        "borderProperties": {
            "type": "object",
            "title": "Border Properties",
            "description": "Complete border styling specification",
            "properties": {
                "color": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Border Color",
                    "description": "Color of the border in hexadecimal format",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "width": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Border Width",
                    "description": "Thickness of the border line",
                    "pattern": "^[0-9]+(\\.[0-9]+)?pt$"
                },
                "line_style": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Border Line Style",
                    "description": "Style of the border line as supported by python-docx and MS Word",
                    "default": "single",
                    "enum": [
                        "single",
                        "double",
                        "dashed",
                        "dotted",
                        "thick",
                        "none"
                    ]
                }
            },
            "required": [
                "color",
                "width",
                "line_style"
            ]
        },
        "tableRowStyle": {
            "type": "object",
            "title": "Table Row Style",
            "description": "Complete styling specification for table rows",
            "properties": {
                "background_color": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Row Background Color (shading)",
                    "description": "Background color for the table row",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "text_orientation": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Text Orientation",
                    "description": "Direction and orientation of text within cells",
                    "default": "horizontal",
                    "enum": [
                        "horizontal",
                        "vertical_90",
                        "vertical_270"
                    ]
                },
                "row_height": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Row Height",
                    "description": "Height of the table row",
                    "default": "auto",
                    "pattern": "^([0-9]+(\\.[0-9]+)?mm)|(auto)$"
                },
                "vertical_alignment": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Vertical Alignment",
                    "description": "Vertical positioning of content within row cells",
                    "default": "center",
                    "enum": [
                        "top",
                        "center",
                        "bottom"
                    ]
                },
                "borders": {
                    "type": "object",
                    "title": "Row Cell Borders",
                    "description": "Border styling for all cells in the row",
                    "properties": {
                        "top": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Top Border",
                            "description": "Border properties for top edges of row cells"
                        },
                        "bottom": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Bottom Border",
                            "description": "Border properties for bottom edges of row cells"
                        },
                        "left": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Left Border",
                            "description": "Border properties for left edges of row cells"
                        },
                        "right": {
                            "$ref": "#/$defs/borderProperties",
                            "title": "Right Border",
                            "description": "Border properties for right edges of row cells"
                        }
                    },
                    "required": [
                        "top",
                        "bottom",
                        "left",
                        "right"
                    ]
                }
            },
            "required": [
                "background_color",
                "text_orientation",
                "row_height",
                "vertical_alignment",
                "borders"
            ]
        },
        "textStyles": {
            "type": "object",
            "properties": {
                "word_style": {
                    "type": [
                        "null",
                        "string"
                    ],
                    "title": "Microsoft Word Built-in Style",
                    "description": "Base Word style to inherit from. Uses python-docx style names",
                    "enum": [
                        "Normal",
                        "Heading 1",
                        "Heading 2",
                        "Title",
                        "Subtitle",
                        "No Spacing",
                        "Strong",
                        "Quote",
                        "Intense Quote"
                    ]
                },
                "paragraph": {
                    "type": "object",
                    "title": "Paragraph Formatting",
                    "description": "Paragraph-level formatting properties",
                    "properties": {
                        "spacing": {
                            "type": "object",
                            "title": "Paragraph Spacing",
                            "description": "Spacing settings between lines and paragraphs",
                            "properties": {
                                "before": {
                                    "type": "string",
                                    "title": "Spacing Before Paragraph",
                                    "description": "Space before the paragraph begins",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?pt$"
                                },
                                "after": {
                                    "type": "string",
                                    "title": "Spacing After Paragraph",
                                    "description": "Space after the paragraph ends",
                                    "pattern": "^[0-9]+(\\.[0-9]+)?pt$"
                                },
                                "line_spacing": {
                                    "type": "number",
                                    "title": "Line Spacing Multiplier",
                                    "description": "Line spacing within the paragraph as a multiplier of single spacing",
                                    "minimum": 1
                                }
                            },
                            "required": [
                                "before",
                                "after",
                                "line_spacing"
                            ]
                        },
                        "indents": {
                            "type": "object",
                            "title": "Paragraph Indentation",
                            "description": "Indentation settings for paragraph margins",
                            "properties": {
                                "left": {
                                    "type": "string",
                                    "title": "Left Indent",
                                    "description": "Left margin indentation from page edge",
                                    "pattern": "^-?[0-9]+(\\.[0-9]+)?mm$"
                                },
                                "right": {
                                    "type": "string",
                                    "title": "Right Indent",
                                    "description": "Right margin indentation from page edge",
                                    "pattern": "^-?[0-9]+(\\.[0-9]+)?mm$"
                                },
                                "first_line": {
                                    "type": "string",
                                    "title": "First Line Indent",
                                    "description": "Special indentation for the first line of paragraph (negative for hanging indent)",
                                    "pattern": "^-?[0-9]+(\\.[0-9]+)?mm$"
                                }
                            },
                            "required": [
                                "left",
                                "right",
                                "first_line"
                            ]
                        },
                        "alignment": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Text Alignment",
                            "description": "Horizontal alignment of text within the paragraph",
                            "enum": [
                                "left",
                                "right",
                                "center",
                                "justify",
                                "distributed"
                            ]
                        }
                    },
                    "required": [
                        "spacing",
                        "indents",
                        "alignment"
                    ]
                },
                "font": {
                    "type": "object",
                    "title": "Font Properties",
                    "description": "Character-level formatting and font properties",
                    "properties": {
                        "font_name": {
                            "type": "string",
                            "title": "Font Family",
                            "description": "Name of the font family to use",
                            "enum": [
                                "Courier New",
                                "Arial",
                                "Times New Roman",
                                "Calibri",
                                "Aptos",
                                "Cambria"
                            ],
                            "examples": [
                                "Courier New"
                            ]
                        },
                        "font_size": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Font Size",
                            "description": "Size of the font in points",
                            "pattern": "^[0-9]+(\\.[0-9]+)?pt$"
                        },
                        "bold": {
                            "type": "boolean",
                            "title": "Bold Text",
                            "description": "Whether text should be rendered in bold weight"
                        },
                        "italic": {
                            "type": "boolean",
                            "title": "Italic Text",
                            "description": "Whether text should be rendered in italic style"
                        },
                        "underline": {
                            "type": "boolean",
                            "title": "Underline Text",
                            "description": "Whether text should be underlined"
                        },
                        "color": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Font Color",
                            "description": "Text color in hexadecimal format",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        "highlight": {
                            "type": [
                                "null",
                                "string"
                            ],
                            "title": "Text Highlight Color",
                            "description": "Background highlight color for text in hexadecimal format",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                        }
                    },
                    "required": [
                        "font_name",
                        "font_size"
                    ]
                }
            },
            "additionalProperties": false
        }
    }
}