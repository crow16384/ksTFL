## ksTFL C++ renderer — Makevars.win for Windows
## Dependencies: HarfBuzz, FreeType, minizip (linked statically via Rtools)

CXX_STD = CXX20

## Adjust these paths for your Rtools/msys2 installation
HARFBUZZ_DIR = $(R_TOOLS_SOFT)
FREETYPE_DIR = $(R_TOOLS_SOFT)
MINIZIP_DIR  = $(R_TOOLS_SOFT)

PKG_CPPFLAGS = -I../inst/include -I./vendor \
    -I$(HARFBUZZ_DIR)/include/harfbuzz \
    -I$(FREETYPE_DIR)/include/freetype2 \
    -I$(MINIZIP_DIR)/include

PKG_LIBS = -L$(HARFBUZZ_DIR)/lib -lharfbuzz \
    -L$(FREETYPE_DIR)/lib -lfreetype \
    -L$(MINIZIP_DIR)/lib -lminizip -lz \
    $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

SOURCES = init.cpp rcpp_bindings.cpp RcppExports.cpp \
    kstfl/units.cpp \
    kstfl/xml_writer.cpp \
    kstfl/json_parser.cpp \
    kstfl/style_resolver.cpp \
    kstfl/inline_parser.cpp \
    kstfl/font_cache.cpp \
    kstfl/text_measurer.cpp \
    kstfl/logical_table.cpp \
    kstfl/paginator.cpp \
    kstfl/zip_writer.cpp \
    kstfl/docx_emitter.cpp \
    kstfl/renderer.cpp

OBJECTS = $(SOURCES:.cpp=.o)
