## ksTFL C++ renderer - Makevars for Linux/macOS
## Dependencies: HarfBuzz, FreeType, minizip-ng (linked statically or via pkg-config)

CXX_STD = CXX20

## nlohmann/json is header-only; bundled in src/vendor/
PKG_CPPFLAGS = -I../inst/include -I./vendor \
    $(shell pkg-config --cflags harfbuzz freetype2 minizip 2>/dev/null)

PKG_LIBS = $(shell pkg-config --libs harfbuzz freetype2 minizip 2>/dev/null) \
    $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

## Source files - renderer core + Rcpp bindings + C++ tests
SOURCES = init.cpp rcpp_bindings.cpp RcppExports.cpp cpp_tests.cpp \
    kstfl/units.cpp \
    kstfl/style_types.cpp \
    kstfl/xml_writer.cpp \
    kstfl/json_parser.cpp \
    kstfl/style_resolver.cpp \
    kstfl/inline_parser.cpp \
    kstfl/font_cache.cpp \
    kstfl/text_measurer.cpp \
    kstfl/logical_table.cpp \
    kstfl/paginator.cpp \
    kstfl/zip_writer.cpp \
    kstfl/docx_metadata.cpp \
    kstfl/docx_styles.cpp \
    kstfl/docx_emitter.cpp \
    kstfl/renderer.cpp

OBJECTS = init.o rcpp_bindings.o RcppExports.o cpp_tests.o \
    kstfl/units.o \
    kstfl/style_types.o \
    kstfl/xml_writer.o \
    kstfl/json_parser.o \
    kstfl/style_resolver.o \
    kstfl/inline_parser.o \
    kstfl/font_cache.o \
    kstfl/text_measurer.o \
    kstfl/logical_table.o \
    kstfl/paginator.o \
    kstfl/zip_writer.o \
    kstfl/docx_metadata.o \
    kstfl/docx_styles.o \
    kstfl/docx_emitter.o \
    kstfl/renderer.o
