## ksTFL C++ renderer — Makevars
## FreeType, HarfBuzz, and minizip are compiled from vendored sources
## under src/vendor/ (static linking, zero runtime dependencies).
## Windows builds use Makevars.win instead (Rtools-provided static libs).

## Ensure the default goal is 'all' (from shlib.mk), not the first
## explicit vendored-object rule that Make would otherwise pick up.
.DEFAULT_GOAL := all

CXX_STD = CXX20

PKG_CPPFLAGS = -I../inst/include -I./vendor \
    -Ivendor/freetype/include -Ivendor/harfbuzz/src \
    -DHAVE_FREETYPE -DHB_NO_MT
PKG_LIBS = -lz $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

## ---- ksTFL sources --------------------------------------------------------
KSTFL_SOURCES = init.cpp rcpp_bindings.cpp RcppExports.cpp cpp_tests.cpp \
    kstfl/units.cpp \
    kstfl/style_types.cpp \
    kstfl/xml_writer.cpp \
    kstfl/json_parser.cpp \
    kstfl/style_resolver.cpp \
    kstfl/inline_parser.cpp \
    kstfl/font_scanner.cpp \
    kstfl/font_cache.cpp \
    kstfl/text_measurer.cpp \
    kstfl/logical_table.cpp \
    kstfl/paginator.cpp \
    kstfl/zip_writer.cpp \
    kstfl/docx_metadata.cpp \
    kstfl/docx_styles.cpp \
    kstfl/docx_sections.cpp \
    kstfl/docx_document.cpp \
    kstfl/docx_toc.cpp \
    kstfl/docx_layout.cpp \
    kstfl/docx_drawing.cpp \
    kstfl/docx_table.cpp \
    kstfl/docx_page.cpp \
    kstfl/docx_content.cpp \
    kstfl/docx_packager.cpp \
    kstfl/docx_emitter.cpp \
    kstfl/renderer.cpp

KSTFL_OBJECTS = $(KSTFL_SOURCES:.cpp=.o)

## ---- Vendored library objects ----------------------------------------------
VENDORED_OBJECTS = vendor/freetype/ft_all.o vendor/harfbuzz/harfbuzz.o vendor/minizip/mz_all.o

OBJECTS = $(KSTFL_OBJECTS) $(VENDORED_OBJECTS)

## GCC-only warning suppressor: clang does not recognize
## -Wno-stringop-overflow and emits -Wunknown-warning-option.
IS_CLANG = $(shell printf '' | $(CC) -dM -E -x c - 2>/dev/null | grep -q "__clang__" && echo 1 || echo 0)
FT_GCC_ONLY_WARN =
ifeq ($(IS_CLANG),0)
FT_GCC_ONLY_WARN = -Wno-stringop-overflow
endif

## HarfBuzz feature disable flags. These drop subsystems that ksTFL never
## uses (font subsetting, color glyph painting, the new paint API, and the
## helper style APIs). Result: smaller vendor object, faster link, no
## behavioural change for our shaping path. Keep CFF/VAR/BITMAP enabled —
## dropping those would break common font files.
HB_FEATURE_DISABLE = -DHB_NO_SUBSET -DHB_NO_COLOR -DHB_NO_PAINT -DHB_NO_STYLE

## Clang-only warning suppressor for the HarfBuzz amalgamation: upstream
## debug-msg macros pass non-pointer handles through %p and trigger
## -Wformat-pedantic.  These are harmless and not in GCC's flag set.
HB_CLANG_ONLY_WARN =
ifeq ($(IS_CLANG),1)
HB_CLANG_ONLY_WARN = -Wno-format-pedantic
endif

## ---- Compile rules for vendored sources -----------------------------------

## FreeType (C, compiled from single-compilation-unit wrapper)
vendor/freetype/ft_all.o: vendor/freetype/ft_all.c
	@mkdir -p vendor/freetype
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -Ivendor/freetype/include -Ivendor/freetype \
        -DFT2_BUILD_LIBRARY -fno-lto $(FT_GCC_ONLY_WARN) -w -c $< -o $@

## HarfBuzz (C++, single-compilation-unit amalgamation)
vendor/harfbuzz/harfbuzz.o: vendor/harfbuzz/src/harfbuzz.cc
	@mkdir -p vendor/harfbuzz
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) \
	    -Ivendor/harfbuzz/src -Ivendor/freetype/include \
	    -DHAVE_FREETYPE -DHB_NO_MT $(HB_FEATURE_DISABLE) $(HB_CLANG_ONLY_WARN) \
	    -std=c++17 -w -c $< -o $@

## minizip (C, single-compilation-unit wrapper)
vendor/minizip/mz_all.o: vendor/minizip/mz_all.c
	@mkdir -p vendor/minizip
	$(CC) $(ALL_CPPFLAGS) $(ALL_CFLAGS) -w -c $< -o $@
